// Mini-C Grammar for Lark LALR Parser (Explicit Terminals)

program: declaration*

declaration: func_def
           | var_decl

func_def: type_spec IDENT LPAREN [param_list] RPAREN block

param_list: param (COMMA param)*
param: type_spec IDENT

type_spec: TYPE_INT
         | TYPE_FLOAT
         | TYPE_CHAR
         | TYPE_VOID

block: LBRACE block_item* RBRACE

block_item: var_decl
          | statement

var_decl: type_spec declarator (COMMA declarator)* SEMI

declarator: IDENT [ASSIGN expr]

statement: expr_stmt
         | block
         | if_stmt
         | while_stmt
         | for_stmt
         | return_stmt
         | print_stmt
         | empty_stmt

expr_stmt: expr SEMI
empty_stmt: SEMI

if_stmt: IF LPAREN expr RPAREN statement [ELSE statement]

while_stmt: WHILE LPAREN expr RPAREN statement

for_stmt: FOR LPAREN [for_init] SEMI [expr] SEMI [expr] RPAREN statement
for_init: type_spec declarator
        | expr

return_stmt: RETURN [expr] SEMI

print_stmt: PRINT LPAREN expr RPAREN SEMI

expr: assignment

assignment: IDENT ASSIGN assignment
          | logic_or

logic_or: logic_and (OR logic_and)*
logic_and: equality (AND equality)*
equality: relational (EQ_OP relational)*
relational: additive (REL_OP additive)*
additive: term (ADD_OP term)*
term: unary (MUL_OP unary)*
unary: UNARY_OP unary
     | ADD_OP unary
     | postfix

postfix: IDENT LPAREN [args] RPAREN
       | primary

args: expr (COMMA expr)*

primary: INT_LIT
       | FLOAT_LIT
       | CHAR_LIT
       | STRING_LIT
       | IDENT
       | LPAREN expr RPAREN

// Terminal definitions
TYPE_INT.2: "int"
TYPE_FLOAT.2: "float"
TYPE_CHAR.2: "char"
TYPE_VOID.2: "void"

IF.2: "if"
WHILE.2: "while"
FOR.2: "for"
RETURN.2: "return"
PRINT.2: "print"
ELSE.5: "else"

ASSIGN: "="
OR: "||"
AND: "&&"
EQ_OP: "==" | "!="
REL_OP: "<=" | ">=" | "<" | ">"
ADD_OP: "+" | "-"
MUL_OP: "*" | "/" | "%"
UNARY_OP: "!"

LPAREN: "("
RPAREN: ")"
LBRACE: "{"
RBRACE: "}"
COMMA: ","
SEMI: ";"

IDENT: /[a-zA-Z_][a-zA-Z0-9_]*/
INT_LIT: /[0-9]+/
FLOAT_LIT: /[0-9]+\.[0-9]*/
CHAR_LIT: /'([^'\\]|\\.)*'/
STRING_LIT: /"([^"\\]|\\.)*"/

%import common.WS
%ignore WS
